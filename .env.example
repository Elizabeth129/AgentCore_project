# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-1
AWS_PROFILE=
PROJECT_PREFIX=csagent
STAGE=dev

# Cross-region inference profile. Must be enabled for the account in AWS_REGION.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Gateway. The deployed Runtime gets AGENTCORE_GATEWAY_CSAGENT_DEV_TOOLS_URL
# injected automatically; GATEWAY_URL is only the fallback for local runs.
# Read the current values from `agentcore status`.
GATEWAY_URL=
GATEWAY_ID=

# Memory. The deployed Runtime gets MEMORY_CSAGENT_DEV_MEMORY_ID injected
# automatically; MEMORY_ID is only the override used by scripts/inspect_memory.py.
MEMORY_ID=

# Cognito inbound auth. Printed by scripts/create_cognito.py; also written into
# agentcore.json by `--write-config`. Neither value is a secret.
# The test user's PASSWORD is never here — it lives in Secrets Manager under
# csagent/dev/test-user and is read by scripts/get_token.py.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Written by `agentcore deploy`; read it back with `agentcore status`.
AGENT_RUNTIME_ARN=
